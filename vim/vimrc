" vim configuration
" Works with both vim and neovim (neovim sources this via init.vim)

" Leader: Space, matching LazyVim on the Omarchy desktops so leader-based
" muscle memory carries across machines. Must be set before plug#begin, since
" plugins resolve <leader> at the point their mappings are defined.
" Trade-off: Space no longer moves the cursor right in normal mode.
let mapleader = " "
let maplocalleader = "\\"

" Plugin manager: vim-plug (auto-install)
if has('nvim')
    let data_dir = stdpath('data') . '/site'
elseif has('win32') || has('win64')
    let data_dir = '~/vimfiles'
else
    let data_dir = '~/.vim'
endif
if empty(glob(data_dir . '/autoload/plug.vim'))
    silent execute '!curl -fLo ' . data_dir . '/autoload/plug.vim --create-dirs
        \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
    autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

call plug#begin()
Plug 'preservim/nerdtree'
Plug 'vim-airline/vim-airline'
Plug 'tpope/vim-sensible'
" OSC 52 yank for Vims too old for the bundled osc52 package (< 9.1.1984,
" e.g. Debian 12 / Ubuntu 24.04). Newer Vims use the built-in one below.
if !has('nvim') && !has('clipboard_provider')
    Plug 'ojroques/vim-oscyank', { 'branch': 'main' }
endif
call plug#end()

" Display
set number
set relativenumber
syntax on
set cursorline
set showmatch
set laststatus=2

" Colours. Without an explicit scheme Vim falls back to 'default', which keys
" its colours off the terminal palette and a guessed background — the usual
" source of unreadable pairs like red on pink in sshconfig files. habamax ships
" with Vim 9 and Neovim 0.8+; desert is the fallback for anything older.
set background=dark
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
    set termguicolors
endif
silent! colorscheme habamax
if !exists('g:colors_name') || g:colors_name !=# 'habamax'
    silent! colorscheme desert
endif

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase

" Usability
set mouse=a
set clipboard=unnamedplus

" Clipboard over ssh/tmux: there is no X11/Wayland on a server, so unnamedplus
" alone leaves every yank inside Vim. Route the + and * registers through
" OSC 52 instead; tmux (set-clipboard on) forwards it to the local terminal.
" Local sessions keep the native clipboard. Neovim >= 0.10 does this itself.
if !has('nvim') && (!empty($SSH_TTY) || !empty($TMUX))
    if has('clipboard_provider')
        " Vim >= 9.1.1984: bundled osc52 package
        packadd osc52
        let g:osc52_force_avail = 1     " tmux answers the DA1 probe itself, so autodetect fails
        let g:osc52_disable_paste = 1   " terminals block clipboard reads; paste with Ctrl+Shift+V
        set clipmethod=wayland,x11,osc52
    elseif exists(':OSCYankRegister') == 2 || !empty(glob(data_dir . '/plugged/vim-oscyank'))
        " Older Vim: vim-oscyank sends every plain yank
        let g:oscyank_silent = 1
        autocmd TextYankPost * if v:event.operator is 'y' && v:event.regname is ''
            \ | execute 'OSCYankRegister "' | endif
    endif
endif
set wildmenu
set wildmode=longest:full,full
set scrolloff=8
set signcolumn=yes
set hidden
set nobackup
set nowritebackup
set noswapfile
set updatetime=300

" NERDTree
nnoremap <C-n> :NERDTreeToggle<CR>
" Close vim if NERDTree is the only window remaining
autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1
    \ && exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" Clear search highlight with Escape
nnoremap <Esc> :nohlsearch<CR>

" Quick escape from insert mode
inoremap jj <Esc>
